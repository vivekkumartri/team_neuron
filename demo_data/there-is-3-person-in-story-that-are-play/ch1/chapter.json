{
  "title": "Chapter 1",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u090f\u0915 \u2014 \u091a\u094c\u0925\u0940 \u091a\u093e\u0932\n\n\u092d\u0940\u0924\u0930\u0964 \u092e\u0902\u0917\u0932 \u0906\u0935\u093e\u0938 \u0915\u093e \u0915\u093e\u0901\u091a-\u0917\u0941\u0902\u092c\u0926 \u2014 \u0932\u093e\u0932 \u0938\u093e\u0902\u091d\n\n\u0932\u093e\u0932 \u0927\u0942\u0932 \u0917\u0941\u0902\u092c\u0926 \u092a\u0930 \u0928\u093e\u0916\u0942\u0928\u094b\u0902 \u0915\u0940 \u0924\u0930\u0939 \u0938\u0930\u0938\u0930\u093e\u0924\u0940 \u0939\u0948\u0964 \u092c\u093e\u0939\u0930 \u0938\u0942\u0930\u094d\u092f \u0915\u094d\u0937\u093f\u0924\u093f\u091c \u092e\u0947\u0902 \u0906\u0927\u093e \u0921\u0942\u092c\u093e \u0939\u0948\u0964 \u092d\u0940\u0924\u0930 \u092e\u0947\u091c\u093c \u092a\u0930 \u091a\u0941\u0902\u092c\u0915\u0940\u092f \u0936\u0924\u0930\u0902\u091c \u0915\u0940 \u092c\u093f\u0938\u093e\u0924 \u091c\u092e\u0940 \u0939\u0948\u0964\n\n\u092e\u0948\u0902\u2014\u0906\u0930\u0935 \u0938\u0947\u0928\u2014\u0938\u092b\u093c\u0947\u0926 \u0930\u093e\u091c\u093e \u0925\u093e\u092e\u0947 \u092c\u0948\u0920\u093e \u0939\u0942\u0901\u0964 \u0938\u093e\u092e\u0928\u0947 \u092e\u0940\u0930\u093e \u0915\u0940 \u0909\u0901\u0917\u0932\u093f\u092f\u093e\u0901 \u0909\u0938\u0915\u0947 \u0918\u094b\u0921\u093c\u0947 \u092a\u0930 \u091f\u093f\u0915\u0940 \u0939\u0948\u0902\u0964 \u0915\u092c\u0940\u0930 \u0915\u093e\u0932\u0940 \u092e\u094b\u0939\u0930\u094b\u0902 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0938\u0947 \u0939\u092e\u0947\u0902 \u0926\u0947\u0916 \u0930\u0939\u093e \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e \u0918\u094b\u0921\u093c\u093e \u092c\u0922\u093c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e  \n\u0936\u0939\u0964\n\n\u0911\u0915\u094d\u0938\u0940\u091c\u0928 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0915\u0940 \u092a\u0940\u0932\u0940 \u092c\u0924\u094d\u0924\u0940 \u091c\u0932 \u0909\u0920\u0924\u0940 \u0939\u0948\u0964 \u0927\u0940\u092e\u0940 \u0918\u0902\u091f\u0940 \u0915\u092e\u0930\u0947 \u0915\u0940 \u091a\u0941\u092a\u094d\u092a\u0940 \u0915\u093e\u091f\u0924\u0940 \u0939\u0948\u0964\n\n\u0915\u092c\u0940\u0930  \n\u092a\u0939\u0932\u0947 \u0930\u093e\u091c\u093e \u092c\u091a\u093e\u0913\u0964 \u092b\u093f\u0930 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u092e\u0948\u0902 \u0930\u093e\u091c\u093e \u0915\u094b \u092c\u093f\u0938\u093e\u0924 \u092a\u0930 \u0917\u093f\u0930\u0928\u0947 \u0926\u0947\u0924\u093e \u0939\u0942\u0901 \u0914\u0930 \u0926\u0940\u0935\u093e\u0930 \u0915\u0947 \u092a\u093e\u0938 \u092a\u0939\u0941\u0901\u091a\u0915\u0930 \u0911\u0915\u094d\u0938\u0940\u091c\u0928 \u092a\u0948\u0928\u0932 \u0916\u094b\u0932\u0924\u093e \u0939\u0942\u0901\u0964 \u092a\u0930\u094d\u0926\u0947 \u092a\u0930 \u090f\u0915 \u0932\u093e\u0932 \u092a\u0902\u0915\u094d\u0924\u093f \u091a\u092e\u0915\u0924\u0940 \u0939\u0948\u2014\n\n\u092e\u0941\u0916\u094d\u092f \u091f\u0948\u0902\u0915 \u0916\u093e\u0932\u0940\u0964 \u0939\u0938\u094d\u0924\u091a\u093e\u0932\u093f\u0924 \u0935\u093e\u0932\u094d\u0935 \u092c\u0902\u0926\u0964 \u0938\u092e\u092f: \u0928\u094c \u092e\u093f\u0928\u091f \u092a\u0942\u0930\u094d\u0935\u0964\n\n\u0906\u0930\u0935  \n\u0935\u093e\u0932\u094d\u0935 \u092c\u093e\u0939\u0930 \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e \u092e\u0947\u0930\u0947 \u092a\u0940\u091b\u0947 \u0906 \u0916\u0921\u093c\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e  \n\u0939\u092e\u092e\u0947\u0902 \u0938\u0947 \u0915\u094b\u0908 \u092c\u093e\u0939\u0930 \u0928\u0939\u0940\u0902 \u0917\u092f\u093e\u0964\n\n\u0905\u091a\u093e\u0928\u0915 \u090f\u092f\u0930\u0932\u0949\u0915 \u092a\u0930 \u0924\u0940\u0928 \u0927\u0940\u092e\u0940 \u0926\u0938\u094d\u0924\u0915\u0947\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964\n\n\u0920\u0915\u0964\n\n\u0920\u0915\u0964\n\n\u0920\u0915\u0964\n\n\u0939\u092e \u0924\u0940\u0928\u094b\u0902 \u091c\u092e \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u093e\u0939\u0930\u0940 \u0915\u0948\u092e\u0930\u0947 \u0915\u093e \u092a\u0930\u094d\u0926\u093e \u092c\u0930\u094d\u092b\u093c\u0940\u0932\u0947 \u0936\u094b\u0930 \u0938\u0947 \u092d\u0930\u093e \u0939\u0948\u0964 \u092c\u093e\u0939\u0930 \u0924\u093e\u092a\u092e\u093e\u0928 \u0907\u0924\u0928\u093e \u0915\u092e \u0939\u0948 \u0915\u093f \u092c\u093f\u0928\u093e \u092a\u094b\u0936\u093e\u0915 \u0915\u094b\u0908 \u090f\u0915 \u092e\u093f\u0928\u091f \u092d\u0940 \u091c\u0940\u0935\u093f\u0924 \u0928\u0939\u0940\u0902 \u0930\u0939 \u0938\u0915\u0924\u093e\u0964\n\n\u0915\u092c\u0940\u0930 \u092c\u093f\u0938\u093e\u0924 \u0915\u0947 \u092a\u093e\u0938 \u0932\u094c\u091f\u0924\u093e \u0939\u0948\u0964 \u0935\u0939 \u0905\u092a\u0928\u0940 \u0915\u093e\u0932\u0940 \u0930\u093e\u0928\u0940 \u0909\u0920\u093e\u0915\u0930 \u0939\u0925\u0947\u0932\u0940 \u092a\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u092e\u094b\u0939\u0930\u0947 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0932\u093e\u0932 \u0927\u0942\u0932 \u0938\u0947 \u0936\u092c\u094d\u0926 \u0932\u093f\u0916\u0947 \u0939\u0948\u0902\u2014\n\n\u091a\u094c\u0925\u0940 \u091a\u093e\u0932 \u092e\u0924 \u091a\u0932\u0928\u093e\u0964\n\n\u0906\u0930\u0935  \n\u092f\u0939 \u0915\u093f\u0938\u0928\u0947 \u0932\u093f\u0916\u093e?\n\n\u0915\u092c\u0940\u0930  \n\u092e\u0948\u0902\u0928\u0947 \u0928\u0939\u0940\u0902\u0964\n\n\u092e\u0940\u0930\u093e \u092c\u093f\u0938\u093e\u0924 \u0917\u093f\u0928\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e  \n\u0939\u092e \u0924\u0940\u0928-\u0924\u0940\u0928 \u091a\u093e\u0932 \u091a\u0932 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964\n\n\u092a\u0940\u0932\u0940 \u092c\u0924\u094d\u0924\u0940 \u0928\u093e\u0930\u0902\u0917\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u092f\u093e\u0902\u0924\u094d\u0930\u093f\u0915 \u0938\u094d\u0935\u0930  \n\u0938\u0939\u093e\u092f\u0915 \u0911\u0915\u094d\u0938\u0940\u091c\u0928: \u0905\u0920\u093e\u0930\u0939 \u092e\u093f\u0928\u091f\u0964\n\n\u090f\u092f\u0930\u0932\u0949\u0915 \u092a\u0930 \u092b\u093f\u0930 \u0926\u0938\u094d\u0924\u0915 \u0939\u094b\u0924\u0940 \u0939\u0948\u2014\u0907\u0938 \u092c\u093e\u0930 \u0936\u0924\u0930\u0902\u091c \u0915\u0940 \u0932\u092f \u092e\u0947\u0902\u0964 \u0924\u0940\u0928 \u0924\u0947\u091c\u093c, \u090f\u0915 \u0927\u0940\u092e\u0940\u0964\n\n\u092e\u0940\u0930\u093e \u0938\u092b\u093c\u0947\u0926 \u0930\u093e\u091c\u093e \u0915\u0940 \u0913\u0930 \u0926\u0947\u0916\u0924\u0940 \u0939\u0948\u0964 \u0935\u0939 \u0935\u0939\u0940\u0902 \u092a\u0921\u093c\u093e \u0925\u093e \u091c\u0939\u093e\u0901 \u092e\u0948\u0902\u0928\u0947 \u091b\u094b\u0921\u093c\u093e \u0925\u093e\u0964\n\n\u0905\u092c \u0935\u0939 \u0938\u0940\u0927\u093e \u0916\u0921\u093c\u093e \u0939\u0948\u0964\n\n\u0909\u0938\u0915\u0947 \u0928\u0940\u091a\u0947 \u0932\u093e\u0932 \u0927\u0942\u0932 \u0915\u0940 \u090f\u0915 \u092a\u0924\u0932\u0940 \u0930\u0947\u0916\u093e \u090f\u092f\u0930\u0932\u0949\u0915 \u0924\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u0915\u092c\u0940\u0930  \n\u0906\u0930\u0935... \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u091a\u093e\u0932\u0964\n\n\u092c\u093e\u0939\u0930\u0940 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u093e \u092a\u0939\u093f\u092f\u093e \u0905\u092a\u0928\u0947 \u0906\u092a \u0918\u0942\u092e\u0928\u0947 \u0932\u0917\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u0948\u0902 \u0930\u093e\u091c\u093e \u092a\u0930 \u0939\u093e\u0925 \u0930\u0916\u0924\u093e \u0939\u0942\u0901\u0964\n\n\u0906\u0930\u0935  \n\u0928\u0939\u0940\u0902\u0964 \u0905\u092c \u092c\u093e\u0939\u0930 \u0935\u093e\u0932\u0947 \u0915\u0940 \u091a\u093e\u0932 \u0939\u0948\u0964",
  "narration_asset": null,
  "storyboard": []
}