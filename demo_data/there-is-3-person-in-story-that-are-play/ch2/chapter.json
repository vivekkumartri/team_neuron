{
  "title": "Chapter 2",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u0926\u094b \u2014 \u092a\u093e\u0901\u091a\u0935\u0940\u0902 \u091a\u093e\u0932\n\n\u092d\u0940\u0924\u0930\u0964 \u092e\u0902\u0917\u0932 \u0906\u0935\u093e\u0938 \u0915\u093e \u0915\u093e\u0901\u091a-\u0917\u0941\u0902\u092c\u0926 \u2014 \u0932\u0917\u093e\u0924\u093e\u0930\n\n\u0924\u0940\u0938\u0930\u0940 \u0926\u0938\u094d\u0924\u0915 \u0915\u0947 \u092c\u093e\u0926 \u090f\u092f\u0930\u0932\u0949\u0915 \u0915\u0947 \u091b\u094b\u091f\u0947 \u0915\u093e\u0901\u091a \u092e\u0947\u0902 \u092e\u0947\u0930\u093e \u0939\u0940 \u0939\u0947\u0932\u092e\u0947\u091f \u0924\u0948\u0930\u0924\u093e \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u093e \u0939\u0948\u2014\u0916\u093e\u0932\u0940, \u0932\u093e\u0932 \u0927\u0942\u0932 \u0938\u0947 \u0938\u0928\u093e\u0964 \u0909\u0938\u0915\u0947 \u0935\u093e\u0907\u091c\u093c\u0930 \u092a\u0930 \u0909\u0901\u0917\u0932\u0940 \u0938\u0947 \u0932\u093f\u0916\u093e \u0939\u0948\u2014\n\n\u0935\u093e\u0932\u094d\u0935 \u092e\u0924 \u0916\u094b\u0932\u0928\u093e\u0964\n\n\u092e\u0947\u0930\u0947 \u092d\u0940\u0924\u0930 \u092d\u092f \u091c\u092e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0906\u0930\u0935  \n\u091b\u0939 \u092e\u093f\u0928\u091f \u0915\u0940 \u0911\u0915\u094d\u0938\u0940\u091c\u0928 \u092c\u091a\u0940 \u0939\u0948\u0964 \u0905\u092c \u0924\u092f \u0915\u0930\u094b\u2014\u092c\u093e\u0939\u0930 \u0915\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u091d\u0942\u0920\u0940 \u0939\u0948, \u092f\u093e \u092d\u0940\u0924\u0930 \u0915\u094b\u0908 \u0939\u092e\u0938\u0947 \u091d\u0942\u0920 \u092c\u094b\u0932 \u0930\u0939\u093e \u0939\u0948\u0964\n\n\u0915\u092c\u0940\u0930 \u092c\u093f\u0928\u093e \u0909\u0924\u094d\u0924\u0930 \u0926\u093f\u090f \u092c\u093f\u0938\u093e\u0924 \u0938\u0947 \u0915\u093e\u0932\u093e \u0935\u091c\u093c\u0940\u0930 \u0909\u0920\u093e\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u0947 \u0928\u0940\u091a\u0947 \u091b\u093f\u092a\u0940 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923-\u091a\u093f\u092a \u0928\u0940\u0932\u0940 \u091a\u092e\u0915 \u091b\u094b\u0921\u093c\u0924\u0940 \u0939\u0948\u0964\n\n\u090f\u092f\u0930\u0932\u0949\u0915 \u0915\u093e \u0938\u092e\u093e\u0928\u0940\u0915\u0930\u0923 \u092a\u0902\u092a \u0915\u0930\u093e\u0939\u0924\u093e \u0939\u0941\u0906 \u091a\u0932 \u092a\u0921\u093c\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e  \n\u0915\u092c\u0940\u0930, \u0909\u0938\u0947 \u0928\u0940\u091a\u0947 \u0930\u0916\u094b!\n\n\u092e\u0940\u0930\u093e \u091d\u092a\u091f\u0924\u0940 \u0939\u0948\u0964 \u0915\u092c\u0940\u0930 \u092a\u0940\u091b\u0947 \u0939\u091f\u0924\u093e \u0939\u0948\u0964 \u091a\u093f\u092a \u0909\u0938\u0915\u0940 \u092e\u0941\u091f\u094d\u0920\u0940 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948, \u092a\u0930 \u092a\u0902\u092a \u091a\u0932\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u0948\u0902 \u092c\u093f\u0938\u093e\u0924 \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0901\u0964 \u0939\u0930 \u0916\u093e\u0928\u0947 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0938\u0942\u0915\u094d\u0937\u094d\u092e \u0905\u0902\u0915 \u091a\u092e\u0915 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u092a\u093f\u091b\u0932\u0940 \u091a\u093e\u0932\u0947\u0902 \u092e\u0947\u0930\u0940 \u0938\u094d\u092e\u0943\u0924\u093f \u092e\u0947\u0902 \u0932\u094c\u091f\u0924\u0940 \u0939\u0948\u0902\u2014\u092e\u0940\u0930\u093e \u0915\u093e \u0918\u094b\u0921\u093c\u093e, \u0915\u092c\u0940\u0930 \u0915\u093e \u090a\u0901\u091f, \u092e\u0947\u0930\u093e \u0930\u093e\u091c\u093e\u0964\n\n\u0935\u0947 \u091a\u093e\u0932\u0947\u0902 \u0928\u0939\u0940\u0902\u0964 \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0939\u0948\u0902\u0964\n\n\u0906\u0930\u0935  \n\u0939\u092e\u0928\u0947 \u0935\u093e\u0932\u094d\u0935 \u092c\u0902\u0926 \u0915\u093f\u092f\u093e\u0964\n\n\u092e\u0940\u0930\u093e \u0920\u093f\u0920\u0915\u0924\u0940 \u0939\u0948\u0964\n\n\u0906\u0930\u0935  \n\u092e\u0941\u0916\u094d\u092f \u091f\u0948\u0902\u0915 \u0915\u0947 \u0939\u0938\u094d\u0924\u091a\u093e\u0932\u093f\u0924 \u0935\u093e\u0932\u094d\u0935 \u092e\u0947\u0902 \u0926\u0942\u0930\u0938\u094d\u0925 \u091a\u093e\u0932\u0915 \u0932\u0917\u093e \u0939\u0948\u0964 \u092c\u093f\u0938\u093e\u0924 \u0928\u0947 \u0939\u092e\u093e\u0930\u0940 \u091a\u093e\u0932\u094b\u0902 \u0915\u094b \u0906\u0926\u0947\u0936 \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0964 \u091a\u094c\u0925\u0940 \u091a\u093e\u0932 \u092a\u0930 \u0909\u0938\u0928\u0947 \u0935\u093e\u0932\u094d\u0935 \u0918\u0941\u092e\u093e \u0926\u093f\u092f\u093e\u0964\n\n\u0915\u092c\u0940\u0930 \u0905\u092a\u0928\u0940 \u092e\u0941\u091f\u094d\u0920\u0940 \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964\n\n\u0915\u092c\u0940\u0930  \n\u092e\u0941\u091d\u0947 \u091a\u093f\u092a \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092a\u0924\u093e \u0925\u093e\u0964 \u0906\u0926\u0947\u0936 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902\u0964\n\n\u0906\u0930\u0935  \n\u092b\u093f\u0930 \u0935\u091c\u093c\u0940\u0930 \u0915\u094d\u092f\u094b\u0902 \u0909\u0920\u093e\u092f\u093e?\n\n\u0915\u092c\u0940\u0930  \n\u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0909\u0938\u0915\u0947 \u0928\u0940\u091a\u0947 \u0932\u093f\u0916\u093e \u0925\u093e\u2014\u092a\u093e\u0901\u091a\u0935\u0940\u0902 \u091a\u093e\u0932 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0916\u094b\u0932\u0947\u0917\u0940\u0964\n\n\u092a\u0930\u094d\u0926\u0947 \u092a\u0930 \u0938\u092e\u092f \u0918\u091f\u0915\u0930 \u091a\u093e\u0930 \u092e\u093f\u0928\u091f \u0930\u0939 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u090f\u092f\u0930\u0932\u0949\u0915 \u0915\u0947 \u0926\u094b\u0928\u094b\u0902 \u0915\u0915\u094d\u0937\u094b\u0902 \u0915\u093e \u0926\u092c\u093e\u0935 \u092c\u0930\u093e\u092c\u0930 \u0939\u094b\u0928\u0947 \u0932\u0917\u0924\u093e \u0939\u0948, \u092a\u0930 \u092c\u093e\u0939\u0930\u0940 \u0926\u094d\u0935\u093e\u0930 \u0905\u092d\u0940 \u092c\u0902\u0926 \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e \u0939\u0947\u0932\u092e\u0947\u091f \u0915\u0940 \u0913\u0930 \u0926\u0947\u0916\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u0940\u0930\u093e  \n\u0924\u094b \u0926\u0938\u094d\u0924\u0915 \u0915\u093f\u0938\u0928\u0947 \u0926\u0940?\n\n\u0920\u0915\u0964\n\n\u0907\u0938 \u092c\u093e\u0930 \u0906\u0935\u093e\u091c\u093c \u090f\u092f\u0930\u0932\u0949\u0915 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0906\u0924\u0940\u0964\n\n\u0935\u0939 \u0939\u092e\u093e\u0930\u0947 \u092a\u0948\u0930\u094b\u0902 \u0915\u0947 \u0928\u0940\u091a\u0947, \u0906\u0935\u093e\u0938 \u0915\u0940 \u092b\u093c\u0930\u094d\u0936 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0947 \u0906\u0924\u0940 \u0939\u0948\u0964\n\n\u092c\u093f\u0938\u093e\u0924 \u092a\u0930 \u0938\u092b\u093c\u0947\u0926 \u092a\u094d\u092f\u093e\u0926\u093e \u0905\u092a\u0928\u0947-\u0906\u092a \u090f\u0915 \u0916\u093e\u0928\u093e \u0906\u0917\u0947 \u0938\u0930\u0915\u0924\u093e \u0939\u0948\u0964\n\n\u092a\u0930\u094d\u0926\u0947 \u092a\u0930 \u0928\u0908 \u092a\u0902\u0915\u094d\u0924\u093f \u091a\u092e\u0915\u0924\u0940 \u0939\u0948\u2014\n\n\u092a\u093e\u0901\u091a\u0935\u0940\u0902 \u091a\u093e\u0932 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0964 \u0938\u0939\u093e\u092f\u0915 \u091f\u0948\u0902\u0915 \u092e\u0941\u0915\u094d\u0924\u0964\n\n\u0939\u0935\u093e \u0915\u0940 \u0928\u0932\u0940 \u0915\u093e\u0901\u092a\u0924\u0940 \u0939\u0948\u0964 \u0911\u0915\u094d\u0938\u0940\u091c\u0928 \u0915\u093e \u0938\u094d\u0924\u0930 \u092c\u0922\u093c\u0928\u0947 \u0932\u0917\u0924\u093e \u0939\u0948\u0964\n\n\u092b\u093f\u0930 \u0926\u0942\u0938\u0930\u0940 \u092a\u0902\u0915\u094d\u0924\u093f \u0909\u092d\u0930\u0924\u0940 \u0939\u0948\u2014\n\n\u091b\u0920\u0940 \u091a\u093e\u0932: \u090f\u0915 \u0916\u093f\u0932\u093e\u0921\u093c\u0940 \u092c\u093e\u0939\u0930 \u091c\u093e\u090f\u0917\u093e\u0964\n\n\u0915\u092c\u0940\u0930 \u0914\u0930 \u092e\u0940\u0930\u093e \u092e\u0947\u0930\u0940 \u0913\u0930 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u092e\u0947\u0930\u0947 \u0938\u093e\u092e\u0928\u0947 \u0938\u092b\u093c\u0947\u0926 \u0930\u093e\u091c\u093e \u0938\u094d\u0935\u092f\u0902 \u0916\u0921\u093c\u093e \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
  "narration_asset": null,
  "storyboard": []
}