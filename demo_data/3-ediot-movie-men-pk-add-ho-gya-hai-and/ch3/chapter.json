{
  "title": "Chapter 3",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u0924\u0940\u0928 \u2014 \u091a\u093e\u0930 \u0909\u0924\u094d\u0924\u0930\n\n\u092d\u0940\u0924\u0930\u0964 \u092d\u0942\u092e\u093f\u0917\u0924 \u0915\u0915\u094d\u0937 \u2014 \u0932\u0917\u093e\u0924\u093e\u0930\n\n\u0906\u0920\u0964\n\n\u091a\u093e\u0930\u094b\u0902 \u0927\u093e\u0924\u0941-\u092a\u091f\u0932 \u0928\u0940\u0932\u0940 \u0930\u094b\u0936\u0928\u0940 \u091b\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964 \u0930\u0948\u0902\u091a\u094b \u0905\u092a\u0928\u0940 \u0938\u0941\u0928\u094d\u0928 \u092c\u093e\u0901\u0939 \u0938\u0940\u0928\u0947 \u0938\u0947 \u0932\u0917\u093e\u090f \u092a\u091f\u0932 \u092a\u0930 \u091d\u0941\u0915\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u0947 \u0928\u093e\u092e \u0915\u0947 \u0928\u0940\u091a\u0947 \u0936\u092c\u094d\u0926 \u0909\u092d\u0930\u0924\u0947 \u0939\u0948\u0902\u2014\u201c\u091c\u094d\u091e\u093e\u0928\u0964\u201d\n\n\u0938\u093e\u0924\u0964\n\n\u092b\u0930\u0939\u093e\u0928 \u0915\u0947 \u092a\u091f\u0932 \u092a\u0930\u2014\u201c\u0926\u0943\u0937\u094d\u091f\u093f\u0964\u201d \u0930\u093e\u091c\u0942 \u0915\u0947 \u092a\u091f\u0932 \u092a\u0930\u2014\u201c\u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0964\u201d \u092a\u0940\u0915\u0947 \u0915\u0947 \u092a\u091f\u0932 \u092a\u0930\u2014\u201c\u092a\u094d\u0930\u0936\u094d\u0928\u0964\u201d\n\n\u0930\u093e\u091c\u0942  \n\u092f\u0947 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0939\u0948? \u0917\u0932\u0924 \u0909\u0924\u094d\u0924\u0930 \u0926\u093f\u092f\u093e \u0924\u094b?\n\n\u092a\u0940\u0915\u0947  \n\u0924\u094b \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0938\u0939\u0940 \u0938\u0935\u093e\u0932 \u092a\u0942\u091b\u0947\u0917\u0940\u0964\n\n\u091b\u0924 \u0938\u0947 \u091a\u093e\u0930 \u0924\u093e\u0930 \u0928\u0940\u091a\u0947 \u0917\u093f\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0930\u093f\u090f\u0915\u094d\u091f\u0930 \u0930\u0948\u0902\u091a\u094b \u0915\u0940 \u0915\u092e\u0930 \u0938\u0947 \u092c\u0901\u0927\u093e \u0915\u093e\u0901\u092a\u0924\u093e \u0939\u0948\u0964 \u092a\u0940\u0915\u0947 \u0932\u093e\u0932 \u0924\u093e\u0930 \u092a\u0915\u0921\u093c\u0924\u093e \u0939\u0948, \u092e\u0917\u0930 \u091c\u094b\u0921\u093c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0930\u0941\u0915 \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092a\u0940\u0915\u0947  \n\u091a\u093e\u0930 \u0928\u093e\u092e \u0939\u0948\u0902, \u092a\u0930 \u092c\u093f\u091c\u0932\u0940 \u090f\u0915 \u0915\u094b \u0915\u094d\u092f\u094b\u0902 \u091a\u093e\u0939\u093f\u090f?\n\n\u091b\u0939\u0964\n\n\u092b\u0930\u0939\u093e\u0928 \u0926\u0940\u0935\u093e\u0930 \u092a\u0930 \u0915\u0948\u092e\u0930\u0947 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0921\u093e\u0932\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0930\u094b\u0902 \u0915\u0940 \u092a\u0930\u091b\u093e\u0907\u092f\u093e\u0901 \u092e\u093f\u0932\u0915\u0930 \u090f\u0915 \u0917\u094b\u0932 \u0906\u0915\u0943\u0924\u093f \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092c\u0940\u091a \u092e\u0947\u0902 \u0939\u0925\u0947\u0932\u0940 \u091c\u093f\u0924\u0928\u093e \u0915\u093e\u0932\u093e \u0928\u093f\u0936\u093e\u0928 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n\n\u092b\u0930\u0939\u093e\u0928  \n\u092a\u091f\u0932 \u0939\u092e\u0947\u0902 \u0905\u0932\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0939\u092e\u093e\u0930\u0940 \u092e\u093f\u0932\u0940 \u0939\u0941\u0908 \u092a\u0930\u091b\u093e\u0908\u0902 \u092e\u0947\u0902 \u0939\u0948\u0964\n\n\u0930\u093e\u091c\u0942 \u0905\u092a\u0928\u0947 \u092a\u091f\u0932 \u0938\u0947 \u0939\u091f\u0924\u093e \u0939\u0948\u0964 \u0924\u0924\u094d\u0915\u093e\u0932 \u0909\u0938\u0915\u0947 \u0928\u093e\u092e \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0932\u093e\u0932 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u092a\u093e\u0901\u091a\u0964\n\n\u0930\u0948\u0902\u091a\u094b  \n\u0938\u092d\u0940 \u092a\u091f\u0932 \u0926\u092c\u0947 \u0930\u0939\u0928\u0947 \u091a\u093e\u0939\u093f\u090f\u0964 \u0939\u092e\u0947\u0902 \u0905\u0932\u0917 \u0916\u0921\u093c\u0947 \u0939\u094b\u0915\u0930 \u0938\u093e\u0925 \u0915\u093e\u092e \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964\n\n\u0935\u0939 \u0905\u092a\u0928\u093e \u091c\u0942\u0924\u093e \u0909\u0924\u093e\u0930\u0915\u0930 \u0905\u092a\u0928\u0947 \u092a\u091f\u0932 \u092a\u0930 \u0930\u0916\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092a\u091f\u0932 \u0928\u0939\u0940\u0902 \u091a\u092e\u0915\u0924\u093e\u0964\n\n\u0930\u093e\u091c\u0942  \n\u0907\u0938\u0947 \u0928\u093e\u092e \u0928\u0939\u0940\u0902, \u0907\u0902\u0938\u093e\u0928 \u091a\u093e\u0939\u093f\u090f\u0964\n\n\u091a\u093e\u0930\u0964\n\n\u0930\u093e\u091c\u0942 \u0926\u094b\u0928\u094b\u0902 \u092a\u0948\u0930\u094b\u0902 \u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u091f\u0932 \u092a\u0930 \u091f\u093f\u0915\u0915\u0930 \u0915\u092e\u0930 \u0915\u0940 \u092a\u091f\u094d\u091f\u0940 \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964 \u092a\u091f\u094d\u091f\u0940 \u0930\u0948\u0902\u091a\u094b \u0915\u0940 \u0915\u0932\u093e\u0908 \u0924\u0915 \u092b\u0947\u0902\u0915\u0924\u093e \u0939\u0948\u0964 \u092b\u0930\u0939\u093e\u0928 \u0915\u0948\u092e\u0930\u0947 \u0915\u093e \u092b\u0940\u0924\u093e \u092a\u0940\u0915\u0947 \u0915\u094b \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0930\u094b\u0902 \u090f\u0915-\u0926\u0942\u0938\u0930\u0947 \u0938\u0947 \u092c\u0901\u0927 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u0924\u0940\u0928\u0964\n\n\u0930\u0948\u0902\u091a\u094b  \n\u092a\u0940\u0915\u0947, \u0932\u093e\u0932 \u0924\u093e\u0930 \u092b\u0930\u0939\u093e\u0928 \u0915\u0940 \u092c\u0948\u091f\u0930\u0940 \u0938\u0947\u0964 \u092b\u0930\u0939\u093e\u0928, \u0930\u094b\u0936\u0928\u0940 \u092c\u0940\u091a \u092e\u0947\u0902\u0964 \u0930\u093e\u091c\u0942, \u092e\u0947\u0930\u0947 \u0938\u0902\u0915\u0947\u0924 \u092a\u0930 \u0905\u092a\u0928\u093e \u092a\u091f\u0932 \u091b\u094b\u0921\u093c\u0928\u093e\u2014\u0938\u093f\u0930\u094d\u092b \u090f\u0915 \u092a\u0932\u0964\n\n\u0926\u094b\u0964\n\n\u092a\u0940\u0915\u0947 \u0924\u093e\u0930 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u092b\u0930\u0939\u093e\u0928 \u0915\u0948\u092e\u0930\u093e \u0918\u0941\u092e\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u0915\u093e\u0936 \u092a\u0930\u091b\u093e\u0907\u092f\u094b\u0902 \u0915\u094b \u0915\u093e\u0932\u0947 \u0928\u093f\u0936\u093e\u0928 \u092a\u0930 \u0938\u092e\u0947\u091f \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n\n\u090f\u0915\u0964\n\n\u0930\u093e\u091c\u0942 \u0909\u091b\u0932\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u0947 \u092a\u091f\u0932 \u0915\u0947 \u092c\u0941\u091d\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0930\u0948\u0902\u091a\u094b \u092a\u091f\u094d\u091f\u0940 \u0916\u0940\u0902\u091a\u0924\u093e \u0939\u0948; \u091a\u093e\u0930\u094b\u0902 \u090f\u0915 \u0938\u093e\u0925 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u0940 \u0913\u0930 \u0917\u093f\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u0917\u093f\u0928\u0924\u0940 \u0936\u0942\u0928\u094d\u092f \u092a\u0930 \u092a\u0939\u0941\u0901\u091a\u0924\u0940 \u0939\u0948\u0964\n\n\u0935\u093f\u0938\u094d\u092b\u094b\u091f \u0915\u0947 \u092c\u091c\u093e\u092f \u092a\u0942\u0930\u093e \u0915\u0915\u094d\u0937 \u0936\u093e\u0902\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u093e\u0932\u093e \u0928\u093f\u0936\u093e\u0928 \u0916\u0941\u0932\u0915\u0930 \u0928\u0940\u091a\u0947 \u091c\u093e\u0924\u0940 \u0938\u0940\u0922\u093c\u093f\u092f\u093e\u0901 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u0930\u093f\u090f\u0915\u094d\u091f\u0930 \u0915\u0940 \u0917\u0930\u094d\u092e\u0940 \u0909\u0924\u0930\u0924\u0940 \u0939\u0948, \u092a\u0930 \u0909\u0938\u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0947 \u0927\u0940\u092e\u0940 \u0927\u0921\u093c\u0915\u0928 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964\n\n\u092b\u0930\u0939\u093e\u0928  \n\u0939\u092e\u0928\u0947 \u0907\u0938\u0947 \u0930\u094b\u0915 \u0926\u093f\u092f\u093e?\n\n\u0930\u0948\u0902\u091a\u094b \u0905\u092a\u0928\u0940 \u0909\u0901\u0917\u0932\u093f\u092f\u093e\u0901 \u0939\u093f\u0932\u093e\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0909\u0901\u0917\u0932\u0940 \u0915\u093e\u0901\u092a\u0924\u0940 \u0939\u0948\u0964\n\n\u0930\u0948\u0902\u091a\u094b  \n\u0928\u0939\u0940\u0902\u0964 \u0939\u092e\u0928\u0947 \u0907\u0938\u0947 \u092c\u0924\u093e \u0926\u093f\u092f\u093e \u0915\u093f \u0939\u092e \u091a\u093e\u0930 \u0939\u0948\u0902\u0964\n\n\u0938\u0940\u0922\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0928\u0940\u091a\u0947 \u091a\u093e\u0930 \u0928\u0908 \u0930\u094b\u0936\u0928\u093f\u092f\u093e\u0901 \u091c\u0932 \u0909\u0920\u0924\u0940 \u0939\u0948\u0902\u2014\u0914\u0930 \u0909\u0928\u0915\u0947 \u092c\u0940\u091a \u092a\u093e\u0901\u091a\u0935\u093e\u0901 \u0916\u093e\u0932\u0940 \u092a\u091f\u0932\u0964",
  "narration_asset": null,
  "storyboard": []
}