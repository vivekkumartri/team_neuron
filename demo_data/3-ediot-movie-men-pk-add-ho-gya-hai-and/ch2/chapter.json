    },
    {
      "scene_number": 2,
      "location": "\u0915\u0949\u0932\u0947\u091c \u0915\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0932\u093e",
      "action": "\u091a\u093e\u0930\u094b\u0902 \u0938\u092e\u091d\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0928\u0915\u094d\u0936\u093e \u0909\u0928\u0915\u0940 \u091c\u0948\u0935-\u090a\u0930\u094d\u091c\u093e \u0915\u0939\u0940\u0902 \u092d\u0947\u091c \u0930\u0939\u093e \u0939\u0948, \u091c\u092c\u0915\u093f \u0930\u093e\u091c\u0942 \u0915\u0940 \u0939\u0925\u0947\u0932\u0940 \u0938\u094d\u0935\u093f\u091a \u0938\u0947 \u091a\u093f\u092a\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0909\u0932\u091f\u0940 \u0917\u093f\u0928\u0924\u0940 \u092c\u0940\u0938 \u0938\u0947\u0915\u0902\u0921 \u092a\u0930 \u092a\u0939\u0941\u0901\u091a\u0924\u0940 \u0939\u0948\u0964",
      "emotion": "\u092d\u092f, \u0909\u0932\u091d\u0928 \u0914\u0930 \u0926\u092c\u093e\u0935",
