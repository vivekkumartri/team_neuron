    {
      "scene_number": 3,
      "location": "\u0915\u0949\u0932\u0947\u091c \u0915\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0932\u093e",
      "action": "\u092b\u0930\u0939\u093e\u0928 \u0915\u0948\u092e\u0930\u0947 \u0915\u0940 \u092c\u0948\u091f\u0930\u0940 \u0916\u093e\u0932\u0940 \u0938\u0949\u0915\u0947\u091f \u092e\u0947\u0902 \u0932\u0917\u093e\u0915\u0930 \u0905\u092a\u0928\u093e \u092c\u093f\u0902\u0926\u0941 \u092c\u0941\u091d\u093e\u0924\u093e \u0939\u0948; \u0930\u0948\u0902\u091a\u094b \u092a\u094d\u0930\u0935\u093e\u0939 \u0909\u0932\u091f\u0928\u0947 \u0915\u094b \u0915\u0939\u0924\u093e \u0939\u0948 \u0914\u0930 \u0930\u093e\u091c\u0942 \u0907\u092e\u0930\u091c\u0947\u0902\u0938\u0940 \u0938\u094d\u0935\u093f\u091a \u0916\u0940\u0902\u091a\u0924\u093e \u0939\u0948\u0964",
      "emotion": "\u0938\u093e\u0939\u0938, \u090f\u0915\u093e\u0917\u094d\u0930\u0924\u093e \u0914\u0930 \u092c\u0922\u093c\u0924\u093e \u0924\u0928\u093e\u0935",
