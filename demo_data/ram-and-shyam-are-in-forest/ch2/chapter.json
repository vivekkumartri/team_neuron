{
  "title": "Chapter 2",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u0926\u094b: \u091a\u094c\u0915\u0940 \u0915\u0947 \u0928\u0940\u091a\u0947\n\n\u092c\u093e\u0939\u094d\u092f\u0964 \u0918\u0928\u093e \u091c\u0902\u0917\u0932 \u2014 \u0932\u0917\u093e\u0924\u093e\u0930\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0917\u093f\u0930\u0924\u093e \u0939\u0948\u0964 \u0930\u093e\u092e \u0909\u0938\u0947 \u092c\u093e\u0901\u0939\u094b\u0902 \u092e\u0947\u0902 \u0925\u093e\u092e \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u0918\u093e\u092f\u0932 \u0906\u0926\u092e\u0940 \u0915\u093e\u0901\u092a\u0924\u0947 \u0939\u093e\u0925 \u0938\u0947 \u092a\u0940\u0924\u0932 \u0915\u0940 \u091a\u093e\u092c\u0940 \u0930\u093e\u092e \u0915\u0940 \u092e\u0941\u091f\u094d\u0920\u0940 \u092e\u0947\u0902 \u0926\u092c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915  \n\u092a\u0941\u0930\u093e\u0928\u0940 \u091a\u094c\u0915\u0940... \u0915\u093e\u0908 \u0935\u093e\u0932\u093e \u0926\u0930\u0935\u093e\u091c\u093c\u093e\u0964 \u0938\u0942\u0930\u091c \u0921\u0942\u092c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0928\u093e\u0964\n\n\u091d\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0917\u0941\u0930\u094d\u0930\u093e\u0939\u091f \u0917\u0942\u0901\u091c\u0924\u0940 \u0939\u0948\u0964 \u0930\u093e\u092e \u0936\u094d\u092f\u093e\u092e \u0915\u0940 \u0913\u0930 \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u093e\u092e  \n\u0907\u0928\u094d\u0939\u0947\u0902 \u0938\u0939\u093e\u0930\u093e \u0926\u094b\u0964 \u0939\u092e\u0947\u0902 \u091a\u094c\u0915\u0940 \u0922\u0942\u0901\u0922\u093c\u0928\u0940 \u0939\u094b\u0917\u0940\u2014\u0905\u092d\u0940\u0964\n\n\u0924\u0940\u0928\u094b\u0902 \u0932\u0921\u093c\u0916\u0921\u093c\u093e\u0924\u0947 \u0939\u0941\u090f \u092a\u0947\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u0940\u091b\u0947 \u0938\u0942\u0916\u0940 \u091f\u0939\u0928\u093f\u092f\u093e\u0901 \u091f\u0942\u091f\u0924\u0940 \u0939\u0948\u0902, \u092e\u093e\u0928\u094b \u0915\u094b\u0908 \u092c\u093f\u0928\u093e \u091c\u0932\u094d\u0926\u0940 \u0915\u093f\u090f \u0909\u0928\u0915\u093e \u092a\u0940\u091b\u093e \u0915\u0930 \u0930\u0939\u093e \u0939\u094b\u0964\n\n\u092c\u093e\u0939\u094d\u092f\u0964 \u092a\u0941\u0930\u093e\u0928\u0940 \u0935\u0928 \u091a\u094c\u0915\u0940 \u2014 \u0915\u0941\u091b \u0926\u0947\u0930 \u092c\u093e\u0926\n\n\u092a\u0924\u094d\u0925\u0930\u094b\u0902 \u0914\u0930 \u092c\u0947\u0932\u094b\u0902 \u092e\u0947\u0902 \u0926\u092c\u0940 \u091b\u094b\u091f\u0940 \u091a\u094c\u0915\u0940 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0905\u0902\u0924\u093f\u092e \u0927\u0942\u092a \u0909\u0938\u0915\u0940 \u091f\u0942\u091f\u0940 \u091b\u0924 \u092a\u0930 \u0915\u093e\u0901\u092a \u0930\u0939\u0940 \u0939\u0948\u0964\n\n\u0930\u093e\u092e \u091a\u093e\u092c\u0940 \u0924\u093e\u0932\u0947 \u092e\u0947\u0902 \u0921\u093e\u0932\u0924\u093e \u0939\u0948\u0964 \u091c\u0948\u0938\u0947 \u0939\u0940 \u0935\u0939 \u0918\u0941\u092e\u093e\u0924\u093e \u0939\u0948, \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u092d\u0940\u0924\u0930 \u0938\u0947 \u091d\u091f\u0915\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0930\u0941\u0915 \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0936\u094d\u092f\u093e\u092e  \n\u0905\u0902\u0926\u0930 \u0915\u094b\u0908 \u0939\u0948\u0964\n\n\u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0940 \u0926\u0930\u093e\u0930 \u092e\u0947\u0902 \u0905\u0901\u0927\u0947\u0930\u093e \u0939\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0926\u094b \u092a\u0940\u0932\u0940 \u0906\u0901\u0916\u0947\u0902 \u0916\u0941\u0932\u0924\u0940 \u0939\u0948\u0902\u0964 \u0909\u0938\u0940 \u0915\u094d\u0937\u0923 \u092a\u0940\u091b\u0947 \u0938\u0947 \u0917\u0941\u0930\u094d\u0930\u093e\u0939\u091f \u0907\u0924\u0928\u0940 \u0928\u093f\u0915\u091f \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948 \u0915\u093f \u0930\u093e\u092e \u0915\u0940 \u0917\u0930\u094d\u0926\u0928 \u092a\u0930 \u0917\u0930\u094d\u092e \u0938\u093e\u0901\u0938 \u092a\u0921\u093c\u0924\u0940 \u0939\u0948\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915  \n\u091c\u093f\u0938\u0947 \u092c\u093e\u0939\u0930 \u0938\u092e\u091d \u0930\u0939\u0947 \u0939\u094b... \u0935\u0939 \u091c\u093e\u0928\u0935\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964\n\n\u0930\u093e\u092e \u0936\u094d\u092f\u093e\u092e \u0915\u094b \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0938\u0947 \u0939\u091f\u093e\u0915\u0930 \u091a\u093e\u092c\u0940 \u0909\u0932\u091f\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u0918\u0941\u092e\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0924\u093e\u0932\u0947 \u0915\u0947 \u0928\u0940\u091a\u0947 \u092a\u0924\u094d\u0925\u0930 \u0916\u093f\u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u091a\u094c\u0915\u0940 \u0915\u0940 \u0926\u0947\u0939\u0930\u0940 \u0926\u094b \u092d\u093e\u0917\u094b\u0902 \u092e\u0947\u0902 \u092c\u0901\u091f\u0915\u0930 \u0928\u0940\u091a\u0947 \u0909\u0924\u0930\u0924\u0940 \u0938\u0901\u0915\u0930\u0940 \u0938\u0940\u0922\u093c\u093f\u092f\u093e\u0901 \u092a\u094d\u0930\u0915\u091f \u0915\u0930\u0924\u0940 \u0939\u0948\u0964\n\n\u0930\u093e\u092e  \n\u0928\u0940\u091a\u0947!\n\n\u0936\u094d\u092f\u093e\u092e \u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0915\u094b \u0932\u0947\u0915\u0930 \u0909\u0924\u0930\u0924\u093e \u0939\u0948\u0964 \u0930\u093e\u092e \u092a\u0940\u091b\u0947 \u0939\u091f\u0924\u0947 \u0939\u0941\u090f \u0905\u0901\u0927\u0947\u0930\u0947 \u091c\u0902\u0917\u0932 \u0915\u094b \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964 \u092a\u0947\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u090f\u0915 \u0932\u0902\u092c\u0940, \u092e\u0928\u0941\u0937\u094d\u092f \u091c\u0948\u0938\u0940 \u0906\u0915\u0943\u0924\u093f \u0916\u0921\u093c\u0940 \u0939\u0948\u2014\u092a\u0930 \u0909\u0938\u0915\u093e \u0938\u093f\u0930 \u0905\u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0922\u0902\u0917 \u0938\u0947 \u091d\u0941\u0915\u093e \u0939\u0941\u0906 \u0939\u0948\u0964\n\n\u0930\u093e\u092e \u0938\u0940\u0922\u093c\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0915\u0942\u0926\u0924\u093e \u0939\u0948\u0964 \u090a\u092a\u0930 \u0915\u0940 \u0926\u0947\u0939\u0930\u0940 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u0906\u0902\u0924\u0930\u093f\u0915\u0964 \u092d\u0942\u092e\u093f\u0917\u0924 \u0915\u0915\u094d\u0937 \u2014 \u0930\u093e\u0924\n\n\u0926\u0940\u0935\u093e\u0930\u094b\u0902 \u092a\u0930 \u092a\u0941\u0930\u093e\u0928\u0947 \u0928\u0915\u094d\u0936\u0947 \u0914\u0930 \u092a\u0902\u091c\u094b\u0902 \u091c\u0948\u0938\u0947 \u0915\u093e\u0932\u0947 \u0928\u093f\u0936\u093e\u0928 \u0939\u0948\u0902\u0964 \u092c\u0940\u091a \u092e\u0947\u0902 \u0932\u094b\u0939\u0947 \u0915\u093e \u090f\u0915 \u092a\u093f\u0902\u091c\u0930\u093e \u0916\u0941\u0932\u093e \u092a\u0921\u093c\u093e \u0939\u0948\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0909\u0938\u0947 \u0926\u0947\u0916\u0915\u0930 \u092a\u0940\u0932\u093e \u092a\u0921\u093c \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915  \n\u092f\u0939 \u0916\u0941\u0932\u093e \u0915\u0948\u0938\u0947?\n\n\u0905\u091a\u093e\u0928\u0915 \u090a\u092a\u0930 \u0938\u0947 \u0924\u0940\u0928 \u0927\u0940\u092e\u0940 \u091a\u094b\u091f\u0947\u0902 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964\n\n\u0920\u0915\u0964 \u0920\u0915\u0964 \u0920\u0915\u0964\n\n\u092b\u093f\u0930 \u0930\u093e\u092e \u0915\u0940 \u0939\u0940 \u0906\u0935\u093e\u091c\u093c \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0947 \u092a\u093e\u0930 \u0938\u0947 \u0906\u0924\u0940 \u0939\u0948\u0964\n\n\u0930\u093e\u092e \u0915\u0940 \u0906\u0935\u093e\u091c\u093c  \n\u0936\u094d\u092f\u093e\u092e, \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u0916\u094b\u0932\u094b\u0964 \u092e\u0948\u0902 \u092c\u093e\u0939\u0930 \u0930\u0939 \u0917\u092f\u093e \u0939\u0942\u0901\u0964\n\n\u0936\u094d\u092f\u093e\u092e \u092d\u092f\u092d\u0940\u0924 \u0939\u094b\u0915\u0930 \u0905\u0938\u0932\u0940 \u0930\u093e\u092e \u0915\u094b \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u093e\u092e \u092c\u0941\u091d\u0924\u0940 \u0932\u093e\u0932\u091f\u0947\u0928 \u0909\u0920\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u093f\u0902\u091c\u0930\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0909\u0938\u0915\u0940 \u0905\u092a\u0928\u0940 \u0915\u092e\u0940\u091c\u093c \u0915\u093e \u092b\u091f\u093e \u0939\u0941\u0906 \u091f\u0941\u0915\u0921\u093c\u093e \u092a\u0921\u093c\u093e \u0939\u0948\u0964",
  "narration_asset": null,
  "storyboard": []
}