{
  "title": "Chapter 1",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u090f\u0915: \u092a\u0940\u0924\u0932 \u0915\u0940 \u091a\u093e\u092c\u0940\n\n\u092c\u093e\u0939\u094d\u092f\u0964 \u0918\u0928\u093e \u091c\u0902\u0917\u0932 \u2014 \u0938\u093e\u0901\u091d\n\n\u0921\u0942\u092c\u0924\u0947 \u0938\u0942\u0930\u091c \u0915\u0940 \u092e\u091f\u092e\u0948\u0932\u0940 \u0930\u094b\u0936\u0928\u0940 \u091f\u0947\u0922\u093c\u0940 \u0936\u093e\u0916\u093e\u0913\u0902 \u092e\u0947\u0902 \u0909\u0932\u091d\u0940 \u0939\u0948\u0964 \u0917\u0940\u0932\u0940 \u092a\u0924\u094d\u0924\u093f\u092f\u094b\u0902 \u092a\u0930 \u0930\u093e\u092e \u0914\u0930 \u0936\u094d\u092f\u093e\u092e \u0915\u0947 \u0924\u0947\u091c\u093c \u0915\u0926\u092e\u094b\u0902 \u0915\u0940 \u091a\u0930\u092e\u0930\u093e\u0939\u091f \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964\n\n\u0930\u093e\u092e \u0930\u0941\u0915\u0915\u0930 \u091a\u093e\u0930\u094b\u0902 \u0913\u0930 \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964 \u0939\u0930 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u090f\u0915-\u091c\u0948\u0938\u0947 \u0924\u0928\u0947, \u0915\u093e\u0908 \u0914\u0930 \u0915\u093e\u0901\u091f\u0947\u0926\u093e\u0930 \u091d\u093e\u0921\u093c\u093f\u092f\u093e\u0901\u0964\n\n\u0930\u093e\u092e \u0915\u0940 \u0906\u0935\u093e\u091c\u093c  \n\u092e\u0948\u0902\u0928\u0947 \u0924\u0940\u0938\u0930\u0940 \u092c\u093e\u0930 \u0909\u0938\u0940 \u091f\u0942\u091f\u0947 \u0939\u0941\u090f \u092a\u0947\u0921\u093c \u0915\u094b \u0926\u0947\u0916\u093e, \u092a\u0930 \u0936\u094d\u092f\u093e\u092e \u0915\u094b \u092c\u0924\u093e\u0928\u0947 \u0915\u0940 \u0939\u093f\u092e\u094d\u092e\u0924 \u0928\u0939\u0940\u0902 \u0939\u0941\u0908\u0964 \u0939\u092e \u0930\u093e\u0938\u094d\u0924\u093e \u0916\u094b \u091a\u0941\u0915\u0947 \u0925\u0947\u0964\n\n\u0936\u094d\u092f\u093e\u092e  \n\u0928\u0926\u0940 \u0909\u0938 \u0924\u0930\u092b\u093c \u0925\u0940... \u0936\u093e\u092f\u0926\u0964\n\n\u0930\u093e\u092e  \n\u0926\u0938 \u092e\u093f\u0928\u091f \u092a\u0939\u0932\u0947 \u0924\u0941\u092e\u0928\u0947 \u0926\u0942\u0938\u0930\u0940 \u0924\u0930\u092b\u093c \u0915\u0939\u093e \u0925\u093e\u0964\n\n\u0905\u091a\u093e\u0928\u0915 \u092d\u093e\u0930\u0940 \u0917\u0941\u0930\u094d\u0930\u093e\u0939\u091f \u091c\u0902\u0917\u0932 \u092e\u0947\u0902 \u0917\u0942\u0901\u091c\u0924\u0940 \u0939\u0948\u0964\n\n\u0926\u094b\u0928\u094b\u0902 \u0938\u094d\u0925\u093f\u0930 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u093e\u0938 \u0915\u0940 \u091d\u093e\u0921\u093c\u0940 \u091c\u093c\u094b\u0930 \u0938\u0947 \u0939\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u0930\u093e\u092e \u0905\u092a\u0928\u093e \u0921\u0930 \u091b\u093f\u092a\u093e\u0915\u0930 \u0936\u094d\u092f\u093e\u092e \u0915\u093e \u0939\u093e\u0925 \u092a\u0915\u0921\u093c \u0932\u0947\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u093e\u092e  \n\u092d\u093e\u0917\u0928\u093e \u092e\u0924\u0964 \u092a\u0939\u0932\u0947 \u092a\u0924\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0935\u0939 \u0915\u094d\u092f\u093e \u0939\u0948\u0964\n\n\u0917\u0941\u0930\u094d\u0930\u093e\u0939\u091f \u0926\u094b\u092c\u093e\u0930\u093e \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0924\u0940 \u0939\u0948\u2014\u0907\u0938 \u092c\u093e\u0930 \u0914\u0930 \u0928\u093f\u0915\u091f\u0964\n\n\u091d\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0938\u0947 \u0916\u0942\u0928 \u0938\u0947 \u0932\u0925\u092a\u0925 \u090f\u0915 \u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0932\u0921\u093c\u0916\u0921\u093c\u093e\u0924\u093e \u0939\u0941\u0906 \u0928\u093f\u0915\u0932\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u0940 \u0935\u0930\u094d\u0926\u0940 \u092b\u091f\u0940 \u0939\u0948 \u0914\u0930 \u0915\u0902\u0927\u0947 \u092a\u0930 \u0917\u0939\u0930\u0947 \u092a\u0902\u091c\u094b\u0902 \u0915\u0947 \u0928\u093f\u0936\u093e\u0928 \u0939\u0948\u0902\u0964 \u0935\u0939 \u0930\u093e\u092e \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0918\u0941\u091f\u0928\u094b\u0902 \u0915\u0947 \u092c\u0932 \u0917\u093f\u0930\u0924\u093e \u0939\u0948\u0964\n\n\u0936\u094d\u092f\u093e\u092e  \n\u092f\u0939 \u0917\u0941\u0930\u094d\u0930\u093e \u0930\u0939\u093e \u0925\u093e?\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u092a\u0940\u091b\u0947 \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964 \u091d\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0905\u0901\u0927\u0947\u0930\u0947 \u092e\u0947\u0902 \u0926\u094b \u092a\u0940\u0932\u0940 \u0906\u0901\u0916\u0947\u0902 \u0916\u0941\u0932\u0924\u0940 \u0939\u0948\u0902\u2014\u0905\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u090a\u0901\u091a\u093e\u0908 \u092a\u0930, \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u094d\u0925\u093f\u0930\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0930\u093e\u092e \u0915\u0940 \u092e\u0941\u091f\u094d\u0920\u0940 \u0916\u094b\u0932\u0915\u0930 \u0909\u0938\u092e\u0947\u0902 \u092a\u0940\u0924\u0932 \u0915\u0940 \u091b\u094b\u091f\u0940 \u091a\u093e\u092c\u0940 \u0926\u092c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u092c\u0940 \u092a\u0930 \u0938\u0942\u0930\u094d\u092f \u091c\u0948\u0938\u093e \u091a\u093f\u0939\u094d\u0928 \u0916\u0941\u0926\u093e \u0939\u0948\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915  \n\u092a\u0941\u0930\u093e\u0928\u093e \u092e\u0902\u0926\u093f\u0930... \u092a\u0939\u093e\u0921\u093c\u0940 \u0915\u0947 \u092a\u093e\u0930\u0964 \u0938\u0942\u0930\u091c \u0921\u0942\u092c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u0939\u0941\u0901\u091a\u094b\u0964\n\n\u0930\u093e\u092e  \n\u0915\u094d\u092f\u094b\u0902? \u092f\u0939 \u091a\u093e\u092c\u0940 \u0915\u093f\u0938\u0915\u0940 \u0939\u0948?\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915  \n\u0926\u0930\u0935\u093e\u091c\u093c\u093e \u092c\u0902\u0926 \u0930\u0916\u0928\u093e \u0925\u093e... \u092e\u0948\u0902\u0928\u0947 \u0909\u0938\u0947 \u0916\u094b\u0932 \u0926\u093f\u092f\u093e\u0964\n\n\u0905\u0901\u0927\u0947\u0930\u0947 \u0938\u0947 \u0938\u0942\u0916\u0940 \u091f\u0939\u0928\u093f\u092f\u093e\u0901 \u091f\u0942\u091f\u0928\u0947 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0906\u0924\u0940 \u0939\u0948\u0964 \u092a\u0940\u0932\u0940 \u0906\u0901\u0916\u0947\u0902 \u090f\u0915 \u0915\u0926\u092e \u0906\u0917\u0947 \u092c\u0922\u093c\u0924\u0940 \u0939\u0948\u0902\u0964 \u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0915\u093e\u0901\u092a\u0924\u0947 \u0939\u093e\u0925 \u0938\u0947 \u092c\u093e\u0908\u0902 \u0913\u0930 \u0915\u0940 \u0938\u0901\u0915\u0930\u0940 \u092a\u0917\u0921\u0902\u0921\u0940 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0935\u0928\u0930\u0915\u094d\u0937\u0915  \n\u0926\u094c\u0921\u093c\u094b!\n\n\u0930\u093e\u092e \u0935\u0928\u0930\u0915\u094d\u0937\u0915 \u0915\u094b \u0909\u0920\u093e\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0948, \u092a\u0930 \u0935\u0939 \u0909\u0938\u0915\u093e \u0939\u093e\u0925 \u091d\u091f\u0915 \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n\n\u0936\u094d\u092f\u093e\u092e \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u093e\u0901\u092a\u0924\u0940 \u0939\u0948\u0964\n\n\u0936\u094d\u092f\u093e\u092e  \n\u0930\u093e\u092e... \u0935\u0939 \u0939\u092e\u093e\u0930\u0947 \u092a\u0940\u091b\u0947 \u0906 \u0930\u0939\u093e \u0939\u0948\u0964\n\n\u0938\u0942\u0930\u091c \u0915\u0940 \u0905\u0902\u0924\u093f\u092e \u0915\u093f\u0930\u0923 \u092a\u0947\u0921\u093c\u094b\u0902 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0921\u0942\u092c\u0924\u0940 \u0939\u0948\u0964 \u0930\u093e\u092e \u091a\u093e\u092c\u0940 \u0915\u0938\u0915\u0930 \u092a\u0915\u0921\u093c\u0924\u093e \u0939\u0948 \u0914\u0930 \u0936\u094d\u092f\u093e\u092e \u0915\u094b \u092a\u0917\u0921\u0902\u0921\u0940 \u0915\u0940 \u0913\u0930 \u0916\u0940\u0902\u091a\u0924\u093e \u0939\u0948\u0964\n\n\u0926\u094b\u0928\u094b\u0902 \u0926\u094c\u0921\u093c \u092a\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u092a\u0940\u091b\u0947 \u0917\u0941\u0930\u094d\u0930\u093e\u0939\u091f \u0928\u0939\u0940\u0902, \u0927\u0940\u092e\u0940 \u092e\u093e\u0928\u0935\u0940\u092f \u0939\u0901\u0938\u0940 \u0917\u0942\u0901\u091c\u0924\u0940 \u0939\u0948\u0964",
  "narration_asset": null,
  "storyboard": []
}