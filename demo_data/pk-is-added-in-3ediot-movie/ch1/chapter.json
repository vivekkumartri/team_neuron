      "action": "\u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u092a\u0922\u093c\u0915\u0930 \u091a\u093e\u0930\u094b\u0902 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940, \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u0940\u0915\u0930\u0923 \u0914\u0930 \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u0916\u0924\u0930\u0947 \u0915\u094b \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964",
      "emotion": "\u090f\u0915\u091c\u0941\u091f\u0924\u093e \u0915\u0947 \u092c\u0940\u091a \u0918\u092c\u0930\u093e\u0939\u091f",
