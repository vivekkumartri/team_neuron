{
  "title": "Chapter 1",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u0967 \u2014 \u0909\u0932\u091f\u0940 \u0918\u0921\u093c\u093f\u092f\u093e\u0901\n\n\u092d\u0940\u0924\u0930\u0964 \u092a\u0941\u0930\u093e\u0928\u0940 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0932\u093e \u2014 \u0930\u093e\u0924\n\n\u0927\u0942\u0932 \u0938\u0947 \u0922\u0915\u0940 \u092e\u0936\u0940\u0928 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0930\u0948\u0902\u091a\u094b \u0906\u0927\u093e \u0918\u0941\u0938\u093e \u0939\u0948\u0964 \u092b\u0930\u0939\u093e\u0928 \u0915\u0948\u092e\u0930\u0947 \u0938\u0947 \u0939\u0930 \u0916\u0941\u0932\u0947 \u0924\u093e\u0930 \u0915\u0940 \u0924\u0938\u094d\u0935\u0940\u0930 \u0932\u0947 \u0930\u0939\u093e \u0939\u0948\u0964 \u0930\u093e\u091c\u0942 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0926\u0942\u0930\u0940 \u092a\u0930 \u0916\u0921\u093c\u093e, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u091a\u093f\u0902\u0917\u093e\u0930\u0940 \u092a\u0930 \u0906\u0901\u0916\u0947\u0902 \u092c\u0902\u0926 \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u092a\u0940\u0915\u0947 \u0909\u0932\u091f\u0940 \u0930\u0916\u0940 \u0915\u0941\u0930\u094d\u0938\u0940 \u092a\u0930 \u092c\u0948\u0920\u0915\u0930 \u0938\u092c \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u0948\u0902\u091a\u094b \u091c\u0932\u093e \u0939\u0941\u0906 \u092a\u0941\u0930\u094d\u091c\u093e \u0928\u093f\u0915\u093e\u0932\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u0948\u0902\u091a\u094b  \n\u092e\u0936\u0940\u0928 \u0916\u0930\u093e\u092c \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0917\u0932\u0924 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0921\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n\n\u0930\u093e\u091c\u0942  \n\u092e\u0936\u0940\u0928 \u0915\u094b \u0915\u094c\u0928 \u0921\u0930\u093e\u0924\u093e \u0939\u0948?\n\n\u092a\u0940\u0915\u0947  \n\u0905\u0917\u0930 \u092e\u0936\u0940\u0928 \u0915\u094b \u0920\u0940\u0915 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u0930 \u0928\u0939\u0940\u0902 \u091a\u093e\u0939\u093f\u090f, \u0924\u094b \u0907\u0902\u0938\u093e\u0928 \u0915\u094b \u0915\u094d\u092f\u094b\u0902?\n\n\u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u0916\u093e\u092e\u094b\u0936\u0940 \u091b\u093e \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092b\u0930\u0939\u093e\u0928 \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0915\u0948\u092e\u0930\u093e \u0928\u0940\u091a\u0947 \u0915\u0930\u0924\u093e \u0939\u0948\u0964\n\n\u092b\u0930\u0939\u093e\u0928  \n\u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0907\u0902\u0938\u093e\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0928\u093f\u092f\u092e-\u092a\u0941\u0938\u094d\u0924\u093f\u0915\u093e \u0906\u0924\u0940 \u0939\u0948\u0964\n\n\u0935\u0939 \u092e\u094b\u091f\u0940 \u0928\u093f\u092f\u092e-\u092a\u0941\u0938\u094d\u0924\u093f\u0915\u093e \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964 \u092a\u0928\u094d\u0928\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u0947 \u0930\u093e\u0916 \u091d\u0930\u0924\u0940 \u0939\u0948\u0964 \u0930\u093e\u091c\u0942 \u0915\u093e\u0901\u092a\u0924\u0940 \u0909\u0901\u0917\u0932\u0940 \u0938\u0947 \u090f\u0915 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u093e\u091c\u0942  \n\u201c\u092a\u094d\u0930\u092f\u094b\u0917 \u0905\u0938\u092b\u0932 \u0939\u094b \u091c\u093e\u090f \u0924\u094b \u091b\u093e\u0924\u094d\u0930 \u0905\u0915\u0947\u0932\u093e \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u094b\u0917\u093e\u0964\u201d\n\n\u092a\u0940\u0915\u0947  \n\u0917\u0932\u0924\u0940 \u0905\u0915\u0947\u0932\u0947 \u0915\u0940 \u0915\u0948\u0938\u0947, \u091c\u092c \u0924\u093e\u0930 \u0938\u092c\u0928\u0947 \u091c\u094b\u0921\u093c\u0947?\n\n\u0930\u0948\u0902\u091a\u094b \u092a\u0941\u0930\u094d\u091c\u093e \u092e\u0947\u091c \u092a\u0930 \u0930\u0916\u0924\u093e \u0939\u0948\u0964 \u092b\u0930\u0939\u093e\u0928 \u0909\u0938\u0915\u0940 \u0924\u0938\u094d\u0935\u0940\u0930 \u0916\u0940\u0902\u091a\u0924\u093e \u0939\u0948\u0964 \u091a\u092e\u0915 \u092e\u0947\u0902 \u091a\u093e\u0930\u094b\u0902 \u0915\u0947 \u091a\u0947\u0939\u0930\u0947 \u090f\u0915 \u092a\u0932 \u0915\u0947 \u0932\u093f\u090f \u092c\u0930\u093e\u092c\u0930 \u0909\u091c\u0932\u0947 \u0926\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u0930\u0948\u0902\u091a\u094b  \n\u0906\u091c \u092e\u0936\u0940\u0928 \u091a\u0932\u0947\u0917\u0940\u0964 \u0939\u0930 \u0924\u093e\u0930 \u092a\u0930 \u0939\u092e \u091a\u093e\u0930\u094b\u0902 \u0915\u0947 \u0928\u093f\u0936\u093e\u0928 \u0939\u094b\u0902\u0917\u0947\u0964\n\n\u092b\u0930\u0939\u093e\u0928  \n\u0939\u0930 \u092c\u0926\u0932\u093e\u0935 \u0915\u0940 \u0924\u0938\u094d\u0935\u0940\u0930 \u0939\u094b\u0917\u0940\u0964\n\n\u0930\u093e\u091c\u0942  \n\u0914\u0930 \u0905\u0917\u0930 \u0935\u093f\u0938\u094d\u092b\u094b\u091f \u0939\u0941\u0906?\n\n\u092a\u0940\u0915\u0947  \n\u0924\u094b \u0921\u0930 \u092d\u0940 \u091a\u093e\u0930 \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0901\u091f \u0932\u0947\u0902\u0917\u0947\u0964\n\n\u0930\u093e\u091c\u0942 \u0905\u0928\u093f\u091a\u094d\u091b\u093e \u0938\u0947 \u092e\u0941\u0938\u094d\u0915\u0930\u093e\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0930\u094b\u0902 \u092e\u0936\u0940\u0928 \u0915\u0947 \u091a\u093e\u0930 \u0913\u0930 \u092c\u0948\u0920\u0924\u0947 \u0939\u0948\u0902\u0964 \u0930\u0948\u0902\u091a\u094b \u0924\u093e\u0930 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948, \u092a\u0940\u0915\u0947 \u092a\u0947\u0902\u091a \u0915\u0938\u0924\u093e \u0939\u0948, \u092b\u0930\u0939\u093e\u0928 \u0915\u094d\u0930\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0930\u093e\u091c\u0942 \u0928\u093f\u092f\u092e-\u092a\u0941\u0938\u094d\u0924\u093f\u0915\u093e \u0915\u093e \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0935\u093e\u0932\u093e \u092a\u0928\u094d\u0928\u093e \u092e\u0936\u0940\u0928 \u0915\u0947 \u0928\u0940\u091a\u0947 \u092c\u093f\u091b\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n\n\u0930\u0948\u0902\u091a\u094b \u0938\u094d\u0935\u093f\u091a \u0926\u092c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u0936\u0940\u0928 \u0918\u0930\u0918\u0930\u093e\u0924\u0940 \u0939\u0948\u0964 \u0928\u0940\u0932\u0940 \u091a\u093f\u0902\u0917\u093e\u0930\u0940 \u091b\u0924 \u0924\u0915 \u0926\u094c\u0921\u093c\u0924\u0940 \u0939\u0948\u0964 \u0926\u0940\u0935\u093e\u0930 \u092a\u0930 \u091f\u0901\u0917\u0940 \u0938\u092d\u0940 \u092c\u0902\u0926 \u0918\u0921\u093c\u093f\u092f\u093e\u0901 \u090f\u0915 \u0938\u093e\u0925 \u091f\u093f\u0915\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948\u0902\u2014\u0909\u0932\u091f\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902\u0964\n\n\u092b\u0930\u0939\u093e\u0928 \u0915\u0940 \u0916\u0940\u0902\u091a\u0940 \u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902 \u0926\u0940\u0935\u093e\u0930 \u092a\u0930 \u091a\u092e\u0915\u0924\u0940 \u0939\u0948\u0902\u0964 \u0909\u0928\u092e\u0947\u0902 \u0915\u0948\u092e\u0930\u093e \u0928\u0939\u0940\u0902, \u0905\u0928\u0916\u093f\u0902\u091a\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902; \u0916\u0941\u0932\u0947 \u0924\u093e\u0930 \u0928\u0939\u0940\u0902, \u0905\u0927\u0942\u0930\u0947 \u092b\u0948\u0938\u0932\u0947; \u0915\u093e\u0901\u092a\u0924\u0940 \u0909\u0901\u0917\u0932\u0940 \u0928\u0939\u0940\u0902, \u0909\u0920\u0924\u093e \u0939\u0941\u0906 \u0939\u093e\u0925\u0964\n\n\u0930\u093e\u091c\u0942  \n\u092f\u0939 \u092e\u0936\u0940\u0928 \u0938\u092e\u092f \u092a\u0940\u091b\u0947 \u0932\u0947 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948?\n\n\u0930\u0948\u0902\u091a\u094b  \n\u0928\u0939\u0940\u0902\u0964 \u0936\u093e\u092f\u0926 \u092c\u0939\u093e\u0928\u0947 \u092a\u0940\u091b\u0947 \u091b\u094b\u0921\u093c \u0930\u0939\u0940 \u0939\u0948\u0964\n\n\u092a\u0940\u0915\u0947 \u090f\u0915 \u0909\u0932\u091f\u0940 \u0918\u0942\u092e\u0924\u0940 \u0918\u0921\u093c\u0940 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0926\u0947\u0916\u0924\u093e \u0939\u0948\u0964\n\n\u092a\u0940\u0915\u0947  \n\u0924\u094b \u092a\u0939\u0932\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u092e\u0936\u0940\u0928 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906\u0964\n\n\u091a\u093e\u0930\u094b\u0902 \u0905\u092a\u0928\u0947 \u092c\u0926\u0932\u0924\u0947 \u092a\u094d\u0930\u0924\u093f\u092c\u093f\u0902\u092c \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u0936\u0940\u0928 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0947 \u091a\u093e\u0930 \u0905\u0932\u0917 \u0927\u0921\u093c\u0915\u0928\u094b\u0902 \u091c\u0948\u0938\u0940 \u0906\u0935\u093e\u091c\u0947\u0902 \u0906\u0924\u0940 \u0939\u0948\u0902\u2014\u092b\u093f\u0930 \u090f\u0915 \u0939\u0940 \u0932\u092f \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u0905\u0902\u0927\u0947\u0930\u093e\u0964",
  "narration_asset": null,
  "storyboard": [
    {
      "scene_number": 1,
      "location": "\u092a\u0941\u0930\u093e\u0928\u0940 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0932\u093e, \u0930\u093e\u0924",
      "action": "\u0927\u0942\u0932 \u092d\u0930\u0940 \u092e\u0936\u0940\u0928 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0930\u0948\u0902\u091a\u094b \u092d\u0940\u0924\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948, \u092b\u0930\u0939\u093e\u0928 \u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902 \u0932\u0947\u0924\u093e \u0939\u0948, \u0930\u093e\u091c\u0942 \u091a\u093f\u0902\u0917\u093e\u0930\u093f\u092f\u094b\u0902 \u0938\u0947 \u092c\u091a\u0924\u093e \u0939\u0948 \u0914\u0930 \u092a\u0940\u0915\u0947 \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
      "emotion": "\u091c\u093f\u091c\u094d\u091e\u093e\u0938\u093e \u0914\u0930 \u0906\u0936\u0902\u0915\u093e",
