      "location": "\u092a\u0941\u0930\u093e\u0928\u0940 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0932\u093e \u0915\u0940 \u092e\u0936\u0940\u0928 \u0915\u0947 \u092a\u093e\u0938",
      "action": "\u091c\u0932\u093e \u092a\u0941\u0930\u094d\u091c\u093e \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092e\u0936\u0940\u0928, \u0921\u0930 \u0914\u0930 \u0907\u0902\u0938\u093e\u0928\u0940 \u0928\u093f\u092f\u092e\u094b\u0902 \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0939\u094b\u0924\u0940 \u0939\u0948; \u092b\u0930\u0939\u093e\u0928 \u0930\u093e\u0916 \u091d\u0930\u0924\u0940 \u0928\u093f\u092f\u092e-\u092a\u0941\u0938\u094d\u0924\u093f\u0915\u093e \u0916\u094b\u0932\u0924\u093e \u0939\u0948\u0964",
