{
  "title": "Chapter 2",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u0968 \u2014 \u0928\u0940\u091a\u0947 \u0915\u0940 \u091c\u0917\u0939\n\n\u092d\u0940\u0924\u0930 \u2014 \u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u2014 \u0932\u0917\u093e\u0924\u093e\u0930\n\n\u0909\u0938\u0915\u0940 \u092a\u0940\u0920 \u091d\u0941\u0915\u0940 \u091b\u0924 \u0938\u0947 \u091f\u0915\u0930\u093e\u0924\u0940 \u0939\u0948\u0964 \u091b\u0924 \u0915\u093e \u090f\u0915 \u091f\u0941\u0915\u0921\u093c\u093e \u091f\u0942\u091f\u0915\u0930 \u092e\u093f\u0928\u094d\u0928\u0940 \u0915\u0940 \u0927\u0942\u092a \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0917\u093f\u0930\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u0915\u0947 \u0915\u093e\u0928 \u092a\u0940\u091b\u0947 \u091d\u0941\u0915 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0939 \u091f\u0942\u091f\u0947 \u0915\u094b\u0928\u0947 \u0915\u094b \u0926\u0947\u0916\u0924\u0940 \u0939\u0948, \u092b\u093f\u0930 \u092c\u093e\u0926\u0932 \u0915\u0940 \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u093e \u0906\u0901\u0916\u094b\u0902 \u0915\u094b\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u092a\u0939\u0932\u0947 \u092e\u0915\u093e\u0928 \u0915\u094b \u0938\u0902\u092d\u093e\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u092b\u093f\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0932\u093f\u090f \u091c\u0917\u0939 \u092c\u0928\u093e\u090f\u0901\u0917\u0947\u0964\n\n\u092c\u093e\u0926\u0932 \u0905\u092a\u0928\u0940 \u092a\u0940\u0920 \u0938\u0947 \u091d\u0941\u0915\u0940 \u091b\u0924 \u0925\u093e\u092e \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u092e\u093f\u0928\u094d\u0928\u0940 \u0917\u093f\u0930\u0947 \u0939\u0941\u090f \u091f\u0941\u0915\u0921\u093c\u0947 \u0915\u094b \u0927\u0915\u0947\u0932\u0915\u0930 \u0915\u093e\u0901\u092a\u0924\u0940 \u0926\u0940\u0935\u093e\u0930 \u0915\u0947 \u0928\u0940\u091a\u0947 \u092b\u0901\u0938\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0964\n\n\u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0930\u093e\u0939\u0924 \u0915\u0940 \u0932\u0902\u092c\u0940 \u091a\u0930\u092e\u0930\u093e\u0939\u091f \u091b\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964\n\n\u0924\u092d\u0940 \u092b\u0930\u094d\u0936 \u0915\u0930\u093e\u0939\u0924\u093e \u0939\u0948\u0964 \u0924\u0916\u094d\u0924\u0947 \u090f\u0915 \u0913\u0930 \u091d\u0941\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092c\u0940\u091a \u092e\u0947\u0902 \u0917\u0939\u0930\u093e \u0917\u0921\u094d\u0922\u093e \u092c\u0928\u0928\u0947 \u0932\u0917\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u092b\u093f\u0938\u0932\u0915\u0930 \u092c\u093e\u0926\u0932 \u0915\u0940 \u092a\u0942\u0901\u091b \u092a\u0915\u0921\u093c \u0932\u0947\u0924\u0940 \u0939\u0948\u0964 \u092c\u093e\u0926\u0932 \u091a\u094c\u0916\u091f \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u092a\u0948\u0930 \u0905\u0921\u093c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0916\u0941\u0926 \u0915\u094b \u0938\u0940\u0927\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u092e\u0947\u0902 \u0914\u0930 \u091f\u0947\u0922\u093c\u093e \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092c\u093e\u0926\u0932  \n\u0932\u0917\u0924\u093e \u0939\u0948 \u092e\u0947\u0930\u0940 \u091c\u0917\u0939 \u090a\u092a\u0930 \u0928\u0939\u0940\u0902, \u0928\u0940\u091a\u0947 \u092c\u0928 \u0930\u0939\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0928\u0940\u091a\u0947 \u0928\u0940\u0902\u0935 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0914\u0930 \u0905\u092d\u0940 \u0935\u0939 \u092d\u093e\u0917 \u0930\u0939\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u092a\u0942\u0901\u091b \u091b\u094b\u0921\u093c\u0915\u0930 \u0917\u0921\u094d\u0922\u0947 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0909\u0924\u0930\u0924\u0940 \u0939\u0948\u0964 \u0928\u0940\u091a\u0947 \u092e\u093f\u091f\u094d\u091f\u0940 \u0916\u093f\u0938\u0915\u0940 \u0939\u0941\u0908 \u0939\u0948\u0964 \u090f\u0915 \u092e\u094b\u091f\u0940 \u092c\u0932\u094d\u0932\u0940 \u0924\u093f\u0930\u091b\u0940 \u092a\u0921\u093c\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0924\u0941\u092e \u091b\u0924 \u092a\u0915\u0921\u093c\u0947 \u0930\u0939\u094b\u0964 \u092e\u0948\u0902 \u0928\u0940\u0902\u0935 \u091c\u0917\u093e\u0924\u0940 \u0939\u0942\u0901\u0964\n\n\u0935\u0939 \u092c\u0932\u094d\u0932\u0940 \u092a\u0930 \u091b\u0932\u093e\u0901\u0917 \u0932\u0917\u093e\u0924\u0940 \u0939\u0948\u0964 \u092c\u0932\u094d\u0932\u0940 \u0939\u093f\u0932\u0924\u0940 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0909\u0920\u0924\u0940 \u0928\u0939\u0940\u0902\u0964 \u092c\u093e\u0926\u0932 \u0917\u0930\u094d\u0926\u0928 \u0928\u0940\u091a\u0947 \u092e\u094b\u0921\u093c\u0915\u0930 \u0905\u092a\u0928\u0940 \u0920\u0941\u0921\u094d\u0921\u0940 \u0909\u0938\u0938\u0947 \u0938\u091f\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0924\u0940\u0928 \u0924\u0915\u0964 \u090f\u0915... \u0926\u094b...\n\n\u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0905\u091a\u093e\u0928\u0915 \u091c\u094b\u0930 \u0938\u0947 \u091a\u0930\u092e\u0930\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0920\u0940\u0915 \u0939\u0948, \u0907\u0938\u0947 \u092d\u0940 \u091c\u0932\u094d\u0926\u0940 \u0939\u0948\u0964 \u0924\u0940\u0928!\n\n\u092c\u093e\u0926\u0932 \u092c\u0932\u094d\u0932\u0940 \u0909\u0920\u093e\u0924\u093e \u0939\u0948\u0964 \u092e\u093f\u0928\u094d\u0928\u0940 \u092a\u0902\u091c\u094b\u0902 \u0938\u0947 \u0928\u0940\u091a\u0947 \u0915\u0940 \u092e\u093f\u091f\u094d\u091f\u0940 \u0938\u092e\u0947\u091f\u0915\u0930 \u092c\u0932\u094d\u0932\u0940 \u0915\u093e \u0938\u093f\u0930\u093e \u0938\u0939\u0940 \u091c\u0917\u0939 \u0916\u093f\u0938\u0915\u093e\u0924\u0940 \u0939\u0948\u0964 \u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0905\u092a\u0928\u0940 \u0926\u0940\u0935\u093e\u0930 \u092d\u0940\u0924\u0930 \u0916\u0940\u0902\u091a\u0924\u093e \u0939\u0948 \u0914\u0930 \u092c\u0932\u094d\u0932\u0940 \u092a\u0930 \u091f\u093f\u0915 \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092b\u0930\u094d\u0936 \u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0938\u092e\u0924\u0932 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092c\u093e\u0926\u0932 \u091b\u0924 \u091b\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0917\u093f\u0930\u0924\u093e\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u0905\u092a\u0928\u0947 \u091f\u0942\u091f\u0947 \u0927\u0942\u092a \u0935\u093e\u0932\u0947 \u0915\u094b\u0928\u0947 \u092e\u0947\u0902 \u092c\u0948\u0920\u0924\u0940 \u0939\u0948\u0964 \u0905\u092c \u0935\u0939\u093e\u0901 \u0927\u0942\u092a \u0915\u0940 \u092a\u0924\u0932\u0940 \u0927\u093e\u0930 \u092c\u093e\u0926\u0932 \u0915\u0940 \u092a\u0940\u0920 \u0938\u0947 \u091b\u0928\u0915\u0930 \u0906\u0924\u0940 \u0939\u0948\u0964\n\n\u092c\u093e\u0926\u0932  \n\u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u091c\u0917\u0939 \u092c\u0928\u0940?\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u0925\u094b\u0921\u093c\u093e \u0938\u0930\u0915\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0906\u0927\u0940\u0964 \u092c\u093e\u0915\u0940 \u0906\u0927\u0940 \u0939\u092e \u0915\u0932 \u092e\u0915\u093e\u0928 \u0938\u0947 \u092a\u0942\u091b\u0915\u0930 \u092c\u0928\u093e\u090f\u0901\u0917\u0947\u0964\n\n\u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0915\u0940 \u0916\u093f\u0921\u093c\u0915\u0940 \u0927\u0940\u0930\u0947 \u0938\u0947 \u0916\u0941\u0932\u0924\u0940 \u0939\u0948\u0964 \u092d\u0940\u0924\u0930 \u0927\u0942\u092a \u0915\u093e \u090f\u0915 \u092c\u0921\u093c\u093e \u091a\u094c\u0915\u094b\u0930 \u091f\u0941\u0915\u0921\u093c\u093e \u092b\u0948\u0932 \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u0914\u0930 \u092c\u093e\u0926\u0932 \u0909\u0938\u092e\u0947\u0902 \u0938\u093e\u0925 \u092c\u0948\u0920\u0924\u0947 \u0939\u0948\u0902\u0964",
  "narration_asset": null,
  "storyboard": []
}