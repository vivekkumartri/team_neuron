{
  "title": "Chapter 1",
  "text": "\u0905\u0927\u094d\u092f\u093e\u092f \u0967 \u2014 \u0928\u092f\u093e \u0906\u0915\u093e\u0930\n\n\u092d\u0940\u0924\u0930 \u2014 \u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u2014 \u0938\u0941\u092c\u0939\n\n\u0939\u0932\u094d\u0915\u0940 \u0939\u0935\u093e \u091a\u0932\u0924\u0947 \u0939\u0940 \u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u091a\u0930\u092e\u0930\u093e\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u0940 \u0924\u093f\u0930\u091b\u0940 \u0916\u093f\u0921\u093c\u0915\u093f\u092f\u093e\u0901 \u0915\u093e\u0901\u092a\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0922\u0932\u0935\u093e\u0901 \u091b\u0924 \u0938\u0947 \u0927\u0942\u0932 \u091d\u0930\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u092b\u0930\u094d\u0936 \u092a\u0930 \u092b\u0948\u0932\u0940 \u0927\u0942\u092a \u092e\u0947\u0902 \u0917\u094b\u0932 \u0939\u094b\u0915\u0930 \u092c\u0948\u0920\u0940 \u0939\u0948\u0964 \u0905\u091a\u093e\u0928\u0915 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u092a\u0930 \u090f\u0915 \u0935\u093f\u0936\u093e\u0932 \u092a\u0930\u091b\u093e\u0908\u0902 \u092a\u0921\u093c\u0924\u0940 \u0939\u0948\u0964\n\n\u092c\u093e\u0926\u0932 \u0905\u092a\u0928\u0940 \u0932\u0902\u092c\u0940 \u0917\u0930\u094d\u0926\u0928 \u091d\u0941\u0915\u093e\u0915\u0930 \u092d\u0940\u0924\u0930 \u0906\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0915\u093e \u0938\u093f\u0930 \u0905\u0902\u0926\u0930 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092c\u093e\u0915\u0940 \u0936\u0930\u0940\u0930 \u091a\u094c\u0916\u091f \u0915\u0947 \u092c\u093e\u0939\u0930 \u0905\u091f\u0915\u093e \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u0909\u0920\u0915\u0930 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0924\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0935\u0939 \u092a\u0902\u091c\u0947 \u0938\u0947 \u091a\u094c\u0916\u091f \u0928\u093e\u092a\u0924\u0940 \u0939\u0948, \u092b\u093f\u0930 \u092c\u093e\u0926\u0932 \u0915\u0947 \u092a\u0948\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0915\u0940 \u091c\u0917\u0939 \u0928\u093e\u092a\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0924\u0941\u092e \u0915\u092e \u0932\u0902\u092c\u0947 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0924\u0947?\n\n\u092c\u093e\u0926\u0932  \n\u0924\u0941\u092e \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u092c\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0940?\n\n\u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0915\u0940 \u0926\u0940\u0935\u093e\u0930\u0947\u0902 \u0928\u093e\u0930\u093e\u091c\u093c \u0939\u094b\u0915\u0930 \u091a\u0930\u092e\u0930\u093e\u0924\u0940 \u0939\u0948\u0902\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0907\u0938\u0947 \u092c\u0941\u0930\u093e \u0932\u0917 \u0917\u092f\u093e\u0964\n\n\u092c\u093e\u0926\u0932 \u0905\u092a\u0928\u0947 \u0918\u0941\u091f\u0928\u0947 \u092e\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964 \u092e\u0915\u093e\u0928 \u0917\u0939\u0930\u0940 \u0938\u093e\u0901\u0938 \u0932\u0947\u0928\u0947 \u091c\u0948\u0938\u093e \u092b\u0942\u0932\u0924\u093e \u0939\u0948\u0964 \u0926\u0940\u0935\u093e\u0930\u0947\u0902 \u0924\u0928\u093f\u0915 \u092c\u093e\u0939\u0930 \u0916\u093f\u0938\u0915\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u090f\u0915 \u0909\u0901\u0917\u0932\u0940 \u091c\u093f\u0924\u0928\u093e \u091a\u094c\u0921\u093c\u093e \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u092c\u093e\u0926\u0932 \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u0906\u0917\u0947 \u0938\u0930\u0915\u0924\u093e \u0939\u0948\u0964\n\n\u0927\u0921\u093c\u093e\u092e!\n\n\u0909\u0938\u0915\u0940 \u092a\u0940\u0920 \u091b\u0924 \u0938\u0947 \u091f\u0915\u0930\u093e\u0924\u0940 \u0939\u0948\u0964 \u091b\u0924 \u0928\u0940\u091a\u0947 \u091d\u0941\u0915\u0924\u0940 \u0939\u0948, \u092b\u0930\u094d\u0936 \u090a\u092a\u0930 \u0909\u091b\u0932\u0924\u093e \u0939\u0948 \u0914\u0930 \u092e\u093f\u0928\u094d\u0928\u0940 \u0915\u0940 \u092a\u0942\u0901\u091b \u092c\u0902\u0926 \u0939\u094b\u0924\u0947 \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u092e\u0947\u0902 \u0905\u091f\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u092e\u0947\u0930\u0940 \u092a\u0942\u0901\u091b!\n\n\u092c\u093e\u0926\u0932 \u0918\u092c\u0930\u093e\u0915\u0930 \u0938\u0940\u0927\u093e \u0939\u094b\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091b\u0924 \u0914\u0930 \u0926\u092c\u0924\u0940 \u0939\u0948\u0964\n\n\u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u092a\u0942\u0930\u0940 \u0924\u093e\u0915\u0924 \u0938\u0947 \u0921\u0917\u092e\u0917\u093e\u0924\u093e \u0939\u0948\u0964 \u0916\u093f\u0921\u093c\u0915\u093f\u092f\u093e\u0901 \u0926\u093e\u090f\u0901 \u091d\u0941\u0915\u0924\u0940 \u0939\u0948\u0902, \u0926\u0930\u0935\u093e\u091c\u093c\u093e \u092c\u093e\u090f\u0901\u0964 \u092e\u093f\u0928\u094d\u0928\u0940 \u0905\u092a\u0928\u0940 \u092a\u0942\u0901\u091b \u0916\u0940\u0902\u091a\u0924\u0940 \u0939\u0948, \u092c\u093e\u0926\u0932 \u092b\u093f\u0930 \u0918\u0941\u091f\u0928\u0947 \u092e\u094b\u0921\u093c\u0924\u093e \u0939\u0948 \u0914\u0930 \u092e\u0915\u093e\u0928 \u0932\u0902\u092c\u0940 \u0915\u0930\u093e\u0939 \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0925\u093f\u0930 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\n\u0915\u0941\u091b \u092a\u0932 \u0938\u0928\u094d\u0928\u093e\u091f\u093e\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u0905\u092a\u0928\u0940 \u092a\u0942\u0901\u091b \u0938\u0901\u0935\u093e\u0930\u0924\u0940 \u0939\u0948\u0964 \u092c\u093e\u0926\u0932 \u0917\u0930\u094d\u0926\u0928 \u092e\u094b\u0921\u093c\u0915\u0930 \u0909\u0938\u0947 \u0926\u0947\u0916\u0924\u093e \u0939\u0948; \u0909\u0938\u0915\u0940 \u0920\u0941\u0921\u094d\u0921\u0940 \u0932\u0917\u092d\u0917 \u092b\u0930\u094d\u0936 \u091b\u0942 \u0930\u0939\u0940 \u0939\u0948\u0964\n\n\u092c\u093e\u0926\u0932  \n\u092e\u0948\u0902 \u0936\u093e\u092f\u0926 \u092c\u0948\u0920\u0915 \u092e\u0947\u0902 \u0938\u094b\u090a\u0901\u0917\u093e\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u091a\u093e\u0930\u094b\u0902 \u0913\u0930 \u0926\u0947\u0916\u0924\u0940 \u0939\u0948\u0964 \u092c\u0948\u0920\u0915 \u0915\u093e \u0906\u0927\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u092c\u093e\u0926\u0932 \u0928\u0947 \u0918\u0947\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964 \u092c\u091a\u0940 \u0939\u0941\u0908 \u091c\u0917\u0939 \u092e\u0947\u0902 \u0935\u0939 \u0905\u092a\u0928\u093e \u091b\u094b\u091f\u093e \u092c\u093f\u0938\u094d\u0924\u0930 \u0916\u0940\u0902\u091a\u0915\u0930 \u0909\u0938\u0915\u0940 \u092e\u0941\u0921\u093c\u0940 \u091f\u093e\u0901\u0917\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0930\u0916 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u0914\u0930 \u092e\u0948\u0902 \u092f\u0939\u0940\u0902\u0964 \u0932\u0947\u0915\u093f\u0928 \u0930\u093e\u0924 \u092e\u0947\u0902 \u0915\u0930\u0935\u091f \u092e\u0924 \u0932\u0947\u0928\u093e\u0964\n\n\u092c\u093e\u0926\u0932  \n\u0924\u0941\u092e \u092e\u0947\u0930\u0940 \u092a\u0940\u0920 \u092a\u0930 \u092e\u0924 \u091a\u0922\u093c\u0928\u093e\u0964\n\n\u092e\u0915\u093e\u0928 \u0927\u0940\u0930\u0947 \u0938\u0947 \u091a\u0930\u092e\u0930\u093e\u0924\u093e \u0939\u0948, \u092e\u093e\u0928\u094b \u0926\u094b\u0928\u094b\u0902 \u0936\u0930\u094d\u0924\u0947\u0902 \u0938\u0941\u0928\u0915\u0930 \u0939\u0901\u0938 \u0930\u0939\u093e \u0939\u094b\u0964\n\n\u0924\u092d\u0940 \u091b\u0924 \u0938\u0947 \u0927\u0942\u0932 \u0915\u0940 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0922\u0947\u0930\u0940 \u092e\u093f\u0928\u094d\u0928\u0940 \u0915\u0947 \u0938\u093f\u0930 \u092a\u0930 \u0917\u093f\u0930\u0924\u0940 \u0939\u0948\u0964 \u092c\u093e\u0926\u0932 \u0915\u0947 \u0915\u093e\u0928 \u0939\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u093f\u0928\u094d\u0928\u0940 \u090a\u092a\u0930 \u0918\u0942\u0930\u0924\u0940 \u0939\u0948\u0964\n\n\u0924\u0940\u0928\u094b\u0902 \u092b\u093f\u0930 \u0921\u0917\u092e\u0917\u093e\u0924\u0947 \u0939\u0948\u0902\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940 \u092e\u0941\u0938\u094d\u0915\u0930\u093e\u0924\u0940 \u0939\u0948\u0964\n\n\u092e\u093f\u0928\u094d\u0928\u0940  \n\u092f\u0939 \u0906\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964\n\n\u092c\u093e\u0926\u0932  \n\u092a\u0930 \u0936\u093e\u0902\u0924 \u092d\u0940 \u0928\u0939\u0940\u0902\u0964\n\n\u091f\u0947\u0922\u093c\u093e-\u092e\u0947\u0922\u093c\u093e \u092e\u0915\u093e\u0928 \u0938\u0939\u092e\u0924\u093f \u092e\u0947\u0902 \u090f\u0915 \u0932\u0902\u092c\u0940, \u092a\u094d\u0930\u0938\u0928\u094d\u0928 \u091a\u0930\u092e\u0930\u093e\u0939\u091f \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
  "narration_asset": null,
  "storyboard": []
}